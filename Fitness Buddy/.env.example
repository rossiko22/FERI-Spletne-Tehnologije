# Put env content in this directory here, root.

# Shared env for the API and docker compose. Loaded by ExpressJS (dotenv ../.env)
# and read by compose.yaml for ${VAR} substitution. This file is gitignored.

# --- Postgres: AUTH database (login/signup live here). ---
# Used both by compose.yaml (to provision the container) and by the API
# (config/authDb.js connects here). The rest of the app stays on SQLite.
POSTGRES_USER=...
POSTGRES_PASSWORD=...
POSTGRES_DB=...
POSTGRES_PORT=...
POSTGRES_HOST=...

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_CALLBACK_URL=...
CLIENT_URL=...

# --- Vapid keys ---
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:..